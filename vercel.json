{
  "redirects": [
    { "source": "/pencil-chess.html", "destination": "https://maldiveschessclub.com/sketch-chess", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/portals.html" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [{ "key": "Content-Type", "value": "text/xsl; charset=utf-8" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
